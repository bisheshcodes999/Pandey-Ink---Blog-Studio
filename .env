# Copy this file to .env and fill in your own values. .env is
# gitignored on purpose - never commit real keys.

# Tavily API key, used for live web research (research_node in
# backend/nodes/research.py). Get a free key at https://tavily.com.
# If left blank, the app still works - topics just get routed as
# closed_book (no research) instead of hybrid/open_book.
TAVILY_API_KEY=

# Which locally-pulled Ollama model to use for every LLM call in the
# pipeline (planning, drafting, fact-check, etc). Must already be
# pulled via `ollama pull <model>` before running the app.
OLLAMA_MODEL=qwen3:8b

# --- Local image generation ---
# No API key needed - illustrations are generated fully offline with
# Stable Diffusion (backend/local_image_gen.py). The model (~2-3GB)
# downloads once from Hugging Face on first use and is cached locally
# after that. If your Hugging Face cache lives on a different drive
# than your OS drive, set HF_HOME as a system/user environment
# variable (not here) to point at it before running the app.

# --- Running the app ---
# venv\Scripts\streamlit run bwa_frontend.py   (Windows)
# venv/bin/streamlit run bwa_frontend.py       (macOS/Linux)
